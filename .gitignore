# Dependencies and build output — regenerated, never tracked.
node_modules/
dist/
.vite/

# Scene-verifier wireframes: regenerated by scene.verify.mjs on demand.
site/.verify/

# Local research evidence: screenshots, and the heavy asset pipelines that feed
# them, stay on disk and out of the repo. The findings they support live in
# research/LESSONS.md and research/POLES.md, which ARE tracked.
research/shots/

# Tool scratch — browser session logs, editor and OS cruft.
.playwright-mcp/
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log

# Offline asset-authoring caches.
__pycache__/
*.pyc
